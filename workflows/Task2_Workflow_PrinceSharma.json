{
  "name": "Task2 - GitHub Trending Morning Brief",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Schedule Trigger (hourly)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [-640, 160]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "github-brief",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "a2222222-2222-4222-8222-222222222222",
      "name": "Webhook (manual test)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-640, 380],
      "webhookId": "github-brief-webhook"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "t1",
              "name": "topic",
              "value": "automation",
              "type": "string"
            },
            {
              "id": "t2",
              "name": "starThreshold",
              "value": 20000,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "a3333333-3333-4333-8333-333333333333",
      "name": "Set Config (topic + threshold)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-420, 260]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/search/repositories?q=topic:{{ $json.topic }}&sort=stars&order=desc&per_page=20",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "a4444444-4444-4444-8444-444444444444",
      "name": "GitHub: Search Repos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-200, 260],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "First HTTP request. GitHub REST search API. onError routes to the Error Handler branch instead of crashing. Retries 3x for transient failures."
    },
    {
      "parameters": {
        "jsCode": "// Transformation: keep only the top 5 repos and reshape to the fields we need.\n// Runs once over the single search response (which contains an `items` array).\nconst res = $input.first().json;\nconst items = Array.isArray(res.items) ? res.items : [];\n\nconst top5 = items.slice(0, 5).map((r) => ({\n  name: r.full_name,\n  stars: r.stargazers_count,\n  description: r.description || '(no description)',\n  url: r.html_url,\n  owner: r.owner && r.owner.login,\n  repo: r.name,\n  default_branch: r.default_branch || 'main',\n}));\n\n// Emit one item per repo so the enrichment step can run per-repo if needed,\n// but we also carry the whole list on the first item for the digest.\nreturn top5.map((repo, i) => ({\n  json: { ...repo, rank: i + 1, top5: i === 0 ? top5 : undefined },\n}));"
      },
      "id": "a5555555-5555-4555-8555-555555555555",
      "name": "Code: Top 5 Repos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [40, 180]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.owner }}/{{ $json.repo }}/readme",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a6666666-6666-4666-8666-666666666666",
      "name": "GitHub: Enrich #1 README",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 180],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "notes": "Second HTTP request (enrichment): fetches each repo's README metadata (size + name). Also routes failures to the Error Handler."
    },
    {
      "parameters": {
        "jsCode": "// Attach a small enrichment signal (README size in KB) to each repo.\nconst item = $input.first().json;\nconst readmeSizeKb = item.size ? Math.round(item.size / 1024) : null;\nconst base = $('Code: Top 5 Repos').first().json; // original repo fields\nreturn [{ json: { ...base, readmeSizeKb } }];"
      },
      "id": "a7777777-7777-4777-8777-777777777777",
      "name": "Code: Attach README size",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.stars }}",
              "rightValue": "={{ $('Set Config (topic + threshold)').first().json.starThreshold }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a8888888-8888-4888-8888-888888888888",
      "name": "IF stars > threshold",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [700, 180],
      "notes": "Conditional branch: repos above the star threshold are tagged HOT; the rest are STANDARD. Threshold is config-driven, not hard-coded in the node."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "h1", "name": "tier", "value": "🔥 HOT", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a9999999-9999-4999-8999-999999999999",
      "name": "Tag HOT",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [920, 80]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "tier", "value": "⭐ STANDARD", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
      "name": "Tag STANDARD",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [920, 280]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "id": "abbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
      "name": "Merge tiers",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1140, 180]
    },
    {
      "parameters": {
        "jsCode": "// Build one Discord message (the digest) from all repos.\nconst repos = $input.all().map((i) => i.json);\nrepos.sort((a, b) => b.stars - a.stars);\n\nconst lines = repos.map(\n  (r) => `${r.tier}  **${r.name}** — ⭐ ${r.stars.toLocaleString()}` +\n    (r.readmeSizeKb ? ` · README ${r.readmeSizeKb}KB` : '') +\n    `\\n${r.description}\\n<${r.url}>`\n);\n\nconst content = `**📰 GitHub Morning Brief — top repos**\\n\\n` + lines.join('\\n\\n');\nreturn [{ json: { content: content.slice(0, 1900) } }]; // Discord 2000-char limit"
      },
      "id": "accccccc-cccc-4ccc-8ccc-cccccccccccc",
      "name": "Code: Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1360, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $credentials.discordWebhook ? $credentials.discordWebhook.url : '' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"content\": $json.content } }}",
        "options": {}
      },
      "id": "addddddd-dddd-4ddd-8ddd-dddddddddddd",
      "name": "Discord: Post Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1580, 180],
      "onError": "continueErrorOutput",
      "notes": "Output: posts the digest to a Discord channel. The webhook URL comes from a Generic Credential (Header Auth / custom) in n8n's Credentials store — NOT hard-coded. See README for the exact credential setup."
    },
    {
      "parameters": {
        "jsCode": "// Error handler: any failed API call lands here instead of crashing the run.\n// Logs a structured, non-sensitive summary. In production this would post to\n// an ops channel or an incident tool.\nconst err = $input.first().json;\nconst summary = {\n  status: 'FAILED',\n  node: err && err.error && err.error.node ? err.error.node.name : 'unknown',\n  message: (err && err.error && err.error.message) || 'Upstream API call failed',\n  at: new Date().toISOString(),\n};\nconsole.log('[workflow-error]', JSON.stringify(summary));\nreturn [{ json: summary }];"
      },
      "id": "aeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee",
      "name": "Error Handler (fallback)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 460],
      "notes": "Fallback branch: receives the error output of the HTTP nodes (Continue-On-Fail). Logs a safe summary so a failed API call is never silent."
    }
  ],
  "connections": {
    "Schedule Trigger (hourly)": {
      "main": [[{ "node": "Set Config (topic + threshold)", "type": "main", "index": 0 }]]
    },
    "Webhook (manual test)": {
      "main": [[{ "node": "Set Config (topic + threshold)", "type": "main", "index": 0 }]]
    },
    "Set Config (topic + threshold)": {
      "main": [[{ "node": "GitHub: Search Repos", "type": "main", "index": 0 }]]
    },
    "GitHub: Search Repos": {
      "main": [
        [{ "node": "Code: Top 5 Repos", "type": "main", "index": 0 }],
        [{ "node": "Error Handler (fallback)", "type": "main", "index": 0 }]
      ]
    },
    "Code: Top 5 Repos": {
      "main": [[{ "node": "GitHub: Enrich #1 README", "type": "main", "index": 0 }]]
    },
    "GitHub: Enrich #1 README": {
      "main": [
        [{ "node": "Code: Attach README size", "type": "main", "index": 0 }],
        [{ "node": "Error Handler (fallback)", "type": "main", "index": 0 }]
      ]
    },
    "Code: Attach README size": {
      "main": [[{ "node": "IF stars > threshold", "type": "main", "index": 0 }]]
    },
    "IF stars > threshold": {
      "main": [
        [{ "node": "Tag HOT", "type": "main", "index": 0 }],
        [{ "node": "Tag STANDARD", "type": "main", "index": 0 }]
      ]
    },
    "Tag HOT": {
      "main": [[{ "node": "Merge tiers", "type": "main", "index": 0 }]]
    },
    "Tag STANDARD": {
      "main": [[{ "node": "Merge tiers", "type": "main", "index": 1 }]]
    },
    "Merge tiers": {
      "main": [[{ "node": "Code: Build Digest", "type": "main", "index": 0 }]]
    },
    "Code: Build Digest": {
      "main": [[{ "node": "Discord: Post Digest", "type": "main", "index": 0 }]]
    },
    "Discord: Post Digest": {
      "main": [
        [],
        [{ "node": "Error Handler (fallback)", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
